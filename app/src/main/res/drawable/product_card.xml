<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android">


    <!-- Card background -->
    <solid
        android:color="@color/white"/>


    <!-- Rounded corners -->
    <corners
        android:radius="15dp"/>


    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="#DDDDDD"/>


    <!-- Space inside the card -->
    <padding
        android:left="15dp"
        android:right="15dp"
        android:top="15dp"
        android:bottom="15dp"/>


</shape>